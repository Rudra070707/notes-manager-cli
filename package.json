{
  "name": "notes-manager-cli",
  "version": "1.0.2",
  "description": "A professional feature-rich command-line Notes Manager built with Node.js, Commander.js, and SQLite.",
  "keywords": [
    "notes",
    "notes-manager",
    "cli",
    "command-line",
    "nodejs",
    "commander",
    "sqlite",
    "productivity",
    "todo",
    "tasks",
    "terminal",
    "javascript",
    "jest"
  ],
  "homepage": "https://github.com/Rudra070707/notes-manager-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rudra070707/notes-manager-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Rudra070707/notes-manager-cli/issues"
  },
  "author": "Rudra Bandekar",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "notes": "index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "commands/",
    "config/",
    "database/",
    "filters/",
    "helpers/",
    "services/",
    "sorters/",
    "ui/",
    "utils/",
    "validators/",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "inquirer": "^14.0.2",
    "prompt-sync": "^4.2.0",
    "prompts": "^2.4.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-mock": "^30.4.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
